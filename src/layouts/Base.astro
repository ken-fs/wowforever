---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { ogImage } from "../data/assets.ts";

interface Props {
  title: string;
  description: string;
  /** 面包屑，最后一项是当前页 */
  crumbs?: { href?: string; label: string }[];
  /** 页面最后更新的 build 号 */
  build?: string;
}
const { title, description, crumbs = [], build } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") + "/", Astro.site).href;
const fullTitle = title.includes("WoW Forever") ? title : `${title} — WoW Forever`;

// GA 走同意门控（见 CookieConsent.astro）。没设这个变量 = 零 JS、无 cookie。
const gaId = import.meta.env.PUBLIC_GA_ID as string | undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage.src, Astro.site).href} />}
    {ogImage && <meta property="og:image:width" content={String(ogImage.width)} />}
    {ogImage && <meta property="og:image:height" content={String(ogImage.height)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#a63d1c" />
  </head>
  <body class="min-h-screen flex flex-col" data-ga={gaId}>
    <SiteHeader />

    <main class="flex-1 w-full max-w-[1100px] mx-auto px-5 sm:px-8 pb-20">
      {
        crumbs.length > 0 && (
          <nav class="pt-6 pb-2 text-[0.78rem] text-ink-faint font-mono" aria-label="Breadcrumb">
            {crumbs.map((c, i) => (
              <>
                {i > 0 && <span class="px-1.5 opacity-50">/</span>}
                {c.href ? <a href={c.href} class="hover:text-rust">{c.label}</a> : <span class="text-ink-soft">{c.label}</span>}
              </>
            ))}
          </nav>
        )
      }
      <slot />
    </main>

    <SiteFooter build={build} />

    {/* GA 只在这里定义加载函数，不注入。CookieConsent 取得同意后才调用它。
        整个块包在条件里 —— 没配 GA_ID 时页面上一行跟踪相关 JS 都没有。 */}
    {gaId && (
      <script is:inline>
      (function () {
        var id = document.body.getAttribute("data-ga");
        if (!id) return;
        window.__wowLoadTrackers = function () {
          if (window.__wowTrackersLoaded) return;
          window.__wowTrackersLoaded = true;
          var s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=" + id;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer.push(arguments); }
          window.gtag = gtag;
          gtag("js", new Date());
          gtag("config", id, { anonymize_ip: true });
        };
      })();
      </script>
    )}

    <CookieConsent />
  </body>
</html>
