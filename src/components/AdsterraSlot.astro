---
import { readFileSync } from "node:fs";
/**
 * AdsterraSlot —— Adsterra 广告位，装在沙箱 iframe 里。
 *
 * ⚠️ 为什么必须用 iframe 隔离、不能直接内联：
 *   Adsterra 的 banner 脚本都往**共享全局** `window.atOptions` 写自己的配置。
 *   同一页内联两个单元 → 后一个覆盖前一个，两个位会渲染成同一个广告。
 *   所以每个单元放独立静态文件 `public/ads/<name>.html`（内容就是 Adsterra
 *   后台 "GET CODE" 那一段原样），这个组件把它挂进 iframe。
 *
 * sandbox 省略 `allow-top-navigation`（部分移动端素材会试图把整页导航走），
 * 也**不给 `allow-same-origin`**（2026-10-31 去掉）：/ads/*.html 和本站同源，给了它广告脚本就能读主页面。
 * 不给时 iframe 是不透明源，素材照样出（站群其他站一直这么配，10-09 aistatement 实测过）。
 *
 * 开关：`PUBLIC_ADSTERRA=1`。没设 = 什么都不渲染，页面零广告 JS。
 *
 * 同意框只管 GA（2026-10-31 用户定）：广告直接加载，和站群其他站一致。
 * 以前广告也等「Allow」，没点的访客一个广告都看不到 —— 10 月整月广告收入 $0.01。
 * 隐私页写明了用 Adsterra、可能写 cookie。
 */
interface Props {
  /** public/ads/ 下的文件名（不含 .html） */
  name: string;
  width: number;
  height: number;
  /** 隐藏"Advertisement"标签 */
  label?: boolean;
  /**
   * 窄屏隐藏。固定尺寸素材在更窄的 iframe 里会裁切
   * （728 的素材在 375px 视口只能显示约一半，还带内部滚动条）。
   */
  hideOnMobile?: boolean;
  /** 宽屏隐藏 —— 和 hideOnMobile 配对，一个断点只出一个尺寸 */
  hideOnDesktop?: boolean;
}

const { name, width, height, label = true, hideOnMobile = false, hideOnDesktop = false } = Astro.props;
const show = !!import.meta.env.PUBLIC_ADSTERRA;
// 素材内联成 srcdoc（由下面的脚本在可见时填入），不再让 iframe 去请求 /ads/<name>.html（10-31）：Cloudflare 会往每个 HTML 响应里自动插访问统计脚本，
// 广告框是不透明源，那个脚本回传被 CORS 拦、控制台报错；同源时它还把广告框算成一次页面浏览，统计里多出 /ads/ 页
const srcdoc = show ? readFileSync(`${process.cwd()}/public/ads/${name}.html`, "utf8") : "";
---
{
  show && (
    <>
      <div
        class:list={[
          "my-8 flex-col items-center justify-center",
          // ⚠️ 两个都要判：只写 hideOnMobile 的话，320 那个会在**宽屏也显示**，
          // 一页就出两个广告（踩过）
          hideOnMobile ? "hidden md:flex" : hideOnDesktop ? "flex md:hidden" : "flex",
        ]}
      >
        {label && (
          <span class="mb-1 text-[10px] font-semibold text-ink-faint">Advertisement</span>
        )}
        <iframe
          data-ad-srcdoc={srcdoc}
          style={`width:100%;max-width:${width}px;height:${height}px;border:0`}
          loading="lazy"
          sandbox="allow-scripts allow-popups allow-popups-to-escape-sandbox allow-forms"
          title="Advertisement"
        />
      </div>
      <script is:inline>
        /* 只在广告位真的显示、且接近视口时才填 srcdoc（10-31）。srcdoc iframe 不吃 loading="lazy"：
           直接写 srcdoc 的话，手机上被 CSS 隐藏的 728×90 也会加载，给看不见的广告记展示（无效展示）。
           display:none 的元素永远不会进入视口，所以隐藏的那个永远不加载。
           只用 ES2018 语法；幂等：每个广告位都带一份，处理过的去掉 data-ad-srcdoc。 */
        (function () {
          var fill = function (f) {
            var html = f.getAttribute("data-ad-srcdoc");
            if (!html) return;
            f.removeAttribute("data-ad-srcdoc");
            f.srcdoc = html;
          };
          var run = function () {
            var frames = document.querySelectorAll("iframe[data-ad-srcdoc]");
            if (!("IntersectionObserver" in window)) {
              for (var i = 0; i < frames.length; i++) if (frames[i].offsetParent) fill(frames[i]);
              return;
            }
            var io = new IntersectionObserver(function (entries) {
              for (var i = 0; i < entries.length; i++) {
                if (entries[i].isIntersecting) { fill(entries[i].target); io.unobserve(entries[i].target); }
              }
            }, { rootMargin: "600px 0px" });
            for (var j = 0; j < frames.length; j++) io.observe(frames[j]);
          };
          if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", run);
          else run();
        })();
      </script>
    </>
  )
}
