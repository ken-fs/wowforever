---
/**
 * AdsterraSlot —— Adsterra 广告位，装在沙箱 iframe 里。
 *
 * ⚠️ 为什么必须用 iframe 隔离、不能直接内联：
 *   Adsterra 的 banner 脚本都往**共享全局** `window.atOptions` 写自己的配置。
 *   同一页内联两个单元 → 后一个覆盖前一个，两个位会渲染成同一个广告。
 *   所以每个单元放独立静态文件 `public/ads/<name>.html`（内容就是 Adsterra
 *   后台 "GET CODE" 那一段原样），这个组件把它挂进 iframe。
 *
 * sandbox 省略 `allow-top-navigation`（部分移动端素材会试图把整页导航走），
 * 但保留了 `allow-scripts allow-same-origin`（素材渲染需要）。
 * ⚠️ 这两者同时存在时，sandbox 是**布局隔离 + 导航摩擦，不是安全边界** ——
 * 真正的隔离需要独立 origin。
 *
 * 开关：`PUBLIC_ADSTERRA=1`。没设 = 什么都不渲染，页面零广告 JS。
 *
 * 同意门控：和 GA 同一套。iframe 先不挂 src（真 URL 在 data-src），
 * 拿到 localStorage 的 `wowforever-consent === 'accepted'` 或收到
 * `wow:consent-accepted` 事件后才提升为 src。
 * 拒绝或未选择 → 永不加载，和同意条上写的承诺一致。
 */
interface Props {
  /** public/ads/ 下的文件名（不含 .html） */
  name: string;
  width: number;
  height: number;
  /** 隐藏"Advertisement"标签 */
  label?: boolean;
  /**
   * 窄屏隐藏。固定尺寸素材在更窄的 iframe 里会裁切
   * （728 的素材在 375px 视口只能显示约一半，还带内部滚动条）。
   */
  hideOnMobile?: boolean;
  /** 宽屏隐藏 —— 和 hideOnMobile 配对，一个断点只出一个尺寸 */
  hideOnDesktop?: boolean;
}

const { name, width, height, label = true, hideOnMobile = false, hideOnDesktop = false } = Astro.props;
const show = !!import.meta.env.PUBLIC_ADSTERRA;
// 同意条只在「有 GA 或开了广告」时渲染（和 CookieConsent.astro 的条件一致）
const consentActive = !!(import.meta.env.PUBLIC_GA_ID || import.meta.env.PUBLIC_ADSTERRA);
const iframeSrc = `/ads/${name}.html`;
---
{
  show && (
    <>
      <div
        class:list={[
          "my-8 flex-col items-center justify-center",
          // ⚠️ 两个都要判：只写 hideOnMobile 的话，320 那个会在**宽屏也显示**，
          // 一页就出两个广告（踩过）
          hideOnMobile ? "hidden md:flex" : hideOnDesktop ? "flex md:hidden" : "flex",
        ]}
      >
        {label && (
          <span class="mb-1 text-[10px] font-semibold text-ink-faint">Advertisement</span>
        )}
        <iframe
          src={consentActive ? undefined : iframeSrc}
          data-src={consentActive ? iframeSrc : undefined}
          data-adsterra-defer={consentActive ? "1" : undefined}
          style={`width:100%;max-width:${width}px;height:${height}px;border:0`}
          loading="lazy"
          sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
          title="Advertisement"
        />
      </div>
      {consentActive && (
        <script is:inline>
          /* 只用 ES2018 语法（不用可选链/空值合并/可选 catch 绑定）——
             这段不过构建工具，老 webview 直接解析。
             幂等：每个广告位都带一份，只处理还挂着 data-adsterra-defer 的 iframe。
             存储键和事件名必须和 CookieConsent.astro 保持一致。 */
          (function () {
            var CONSENT_KEY = "wowforever-consent";
            var CONSENT_EVENT = "wow:consent-accepted";
            var activate = function () {
              var pending = document.querySelectorAll("iframe[data-adsterra-defer]");
              for (var i = 0; i < pending.length; i++) {
                var frame = pending[i];
                var src = frame.getAttribute("data-src");
                if (src) frame.src = src;
                frame.removeAttribute("data-adsterra-defer");
                frame.removeAttribute("data-src");
              }
            };
            var wire = function () {
              var stored = null;
              try {
                stored = localStorage.getItem(CONSENT_KEY);
              } catch (e) {
                /* 隐私模式下 storage 不可用 —— 当作尚未同意 */
              }
              if (stored === "accepted") {
                activate();
                return;
              }
              document.addEventListener(CONSENT_EVENT, activate);
            };
            if (document.readyState === "loading") {
              document.addEventListener("DOMContentLoaded", wire);
            } else {
              wire();
            }
          })();
        </script>
      )}
    </>
  )
}
