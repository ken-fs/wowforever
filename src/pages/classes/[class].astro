---
import AdBreak from "../../components/AdBreak.astro";
import TalentCalculator from "../../components/TalentCalculator.astro";
import Base from "../../layouts/Base.astro";
import { all, one, slug, val } from "../../data/db.ts";
import { Image } from "astro:assets";
import { classIcon, specFor } from "../../data/assets.ts";

const build = val(`SELECT value FROM meta WHERE key='build'`);

export async function getStaticPaths() {
  const classes = all(`SELECT DISTINCT class FROM race_class ORDER BY class`);
  return classes.map((c) => ({ params: { class: slug(c.class) }, props: { cls: c.class } }));
}

const { cls } = Astro.props;

const races = all(`SELECT race, is_skyborne FROM race_class WHERE class = ? ORDER BY race`, cls);
const talents = all(
  `SELECT tab, tier, col, spell_name FROM talent_full WHERE class = ? ORDER BY tab, tier, col`,
  cls,
);
const trees = [...new Set(talents.map((t) => t.tab).filter(Boolean))];
const changed = val(`SELECT COUNT(*) FROM talent_node WHERE class = ? AND status IN ('new','changed')`, cls);
const spellRanks = val(`SELECT COUNT(*) FROM spellbook WHERE class = ?`, cls);

// 这个职业相关的配方（如果专业数据能对上的话）
const recipeCount = val(`SELECT COUNT(*) FROM recipe`);

const ROLE = {
  Warrior: "Tank or melee DPS. Rage, and not much of it.",
  Paladin: "Heals, tanks, or swings. Forever gives it to a third race.",
  Hunter: "Ranged DPS with a pet. The solo-friendly pick.",
  Rogue: "Melee DPS. Stealth, stuns, and a reworked kit in Forever.",
  Priest: "Heals or shadow DPS. The healer most groups expect.",
  Shaman: "Healer or DPS, melee and ranged. Bloodlust on demand.",
  Mage: "Ranged DPS, portals, and food. Always wanted.",
  Warlock: "Ranged DPS with pets and dots. Slow, sturdy, relentless.",
  Druid: "Does everything. Forever's four-race club.",
};
---
<Base
  title={`WoW Forever ${cls} talent calculator, races and spells`}
  description={`Free WoW Forever ${cls} talent calculator with all ${talents.length} talents from the beta client. Share a build, see the ${races.length} races that can play ${cls}.`.slice(0, 165)}
  crumbs={[{ href: "/", label: "Home" }, { href: "/classes/", label: "Classes" }, { label: cls }]}
  {build}
>
  <header class="pt-8 pb-6 border-b border-rule">
    <div class="flex items-center gap-3 mb-3">
      {classIcon[slug(cls)] && (
        <Image src={classIcon[slug(cls)]!} alt="" width={44} height={44} format="webp"
          class="shrink-0" aria-hidden="true" />
      )}
      <div class="flex flex-wrap gap-2">
      <span class="tag">{races.length} of 10 races</span>
      <span class="tag">{talents.length} talents</span>
      <span class="tag">{trees.length} trees</span>
      </div>
    </div>
    <h1 class="text-[2rem] leading-tight">{cls}</h1>
    <p class="mt-3 max-w-[62ch] text-ink-soft leading-relaxed">{ROLE[cls] ?? ""}</p>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href={`/classes/${slug(cls)}/talent-changes/`} class="card px-4 py-2.5 text-[0.92rem]">
        {cls} changes vs Classic <span class="text-ink-faint">· {changed} talents new or changed</span>
      </a>
      <a href={`/classes/${slug(cls)}/spells/`} class="card px-4 py-2.5 text-[0.92rem]">
        Spells by level <span class="text-ink-faint">· {spellRanks} ranks, 1 to 60</span>
      </a>
      {cls === "Mage" && (
        <a href="/classes/mage/portals/" class="card px-4 py-2.5 text-[0.92rem]">
          Portals and teleports <span class="text-ink-faint">· incl. Dalaran</span>
        </a>
      )}
    </div>
  </header>

  <section class="py-8" id="talent-calculator">
    <h2 class="text-[1.4rem] mb-1">{cls} talent calculator</h2>
    <p class="text-[0.9rem] text-ink-soft mb-5 max-w-[66ch]">
      All {talents.length} {cls} talents from the beta, in their real spots. Plan a build, then copy the
      link to share it.
    </p>
    <TalentCalculator {cls} />
  </section>

  <section class="py-8 grid gap-10 lg:grid-cols-[1.3fr_1fr] border-t border-rule">
    <div>
      <h2 class="text-[1.3rem] mb-3">What changed for the {cls}</h2>
      <p class="text-[0.92rem] text-ink-soft leading-relaxed">
        {changed} of the {talents.length} talents are new or different from Classic, and the trainer list moved
        too. <a href={`/classes/${slug(cls)}/talent-changes/`} class="underline decoration-rule-hard underline-offset-2 hover:decoration-rust">Every change, talent by talent →</a>
      </p>
    </div>

<AdBreak />

    <aside>
      <h2 class="text-[1.15rem] mb-3">Races that can be a {cls}</h2>
      <table class="data">
        <thead><tr><th>Race</th><th></th></tr></thead>
        <tbody>
          {
            races.map((r) => (
              <tr>
                <td><a href={`/race-class/${slug(r.race)}-${slug(cls)}/`} class="hover:text-rust">{r.race}</a></td>
                <td class="text-right">{r.is_skyborne ? <span class="tag">new</span> : null}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <div class="border border-rule-hard bg-card p-4 mt-6">
        <p class="text-[0.85rem] text-ink-soft">
          Leveling this class? The{" "}
          <a href="/tools/xp-calculator/" class="underline decoration-rule-hard underline-offset-2 hover:decoration-rust">XP calculator</a>
          works out what 1&ndash;60 costs with your buffs up. {Number(recipeCount).toLocaleString()} profession
          recipes are indexed too.
        </p>
      </div>
    </aside>
  </section>
</Base>
