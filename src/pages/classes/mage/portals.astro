---
import Base from "../../../layouts/Base.astro";
import { all, val } from "../../../data/db.ts";

const build = val(`SELECT value FROM meta WHERE key='build'`);

const spells = all(
  `SELECT b.name, b.level, b.description, b.classic_status, r.item, r.count, r.price
     FROM spellbook b LEFT JOIN spellbook_reagent r ON r.spell_id = b.spell_id
    WHERE b.class = 'Mage' AND (b.name LIKE 'Teleport:%' OR b.name LIKE 'Portal:%')
    ORDER BY b.name LIKE 'Portal:%', b.level, b.name`,
);
const teleports = spells.filter((s) => s.name.startsWith("Teleport:"));
const portals = spells.filter((s) => s.name.startsWith("Portal:"));
const city = (n) => n.replace(/^(Teleport|Portal): /, "");
const ALLIANCE = new Set(["Stormwind", "Ironforge", "Darnassus"]);
const HORDE = new Set(["Orgrimmar", "Undercity", "Thunder Bluff"]);
// Dalaran：文件里只挂了 Alliance 种族（和 Teleport: Stormwind 同一份名单），文件里还有两个同名法术
// 没挂上种族，可能是 Horde 版 —— 没确认前不写「两边都有」
const side = (n) => (ALLIANCE.has(city(n)) ? "Alliance" : HORDE.has(city(n)) ? "Horde" : "Alliance, per the files");
const newOnes = spells.filter((s) => s.classic_status === "new");
const money = (c) => (c == null ? "—" : c >= 10000 ? `${c / 10000}g` : c >= 100 ? `${c / 100}s` : `${c}c`);
const rune = (list) => list.find((s) => s.item);

const title = "WoW Forever mage portals and teleports: levels, runes, Dalaran";
const desc = `Every mage teleport and portal in WoW Forever: the level you learn each one, the rune it costs, and the new Teleport: Dalaran${newOnes.length ? " at level " + newOnes[0].level : ""}. From the beta client.`;
---
<Base {title} description={desc.slice(0, 165)} crumbs={[
  { href: "/", label: "Home" },
  { href: "/classes/", label: "Classes" },
  { href: "/classes/mage/", label: "Mage" },
  { label: "Portals and teleports" },
]} {build}>
  <header class="pt-8 pb-6 border-b border-rule">
    <p class="tag mb-3">Mage</p>
    <h1 class="text-[2rem] sm:text-[2.4rem] leading-tight max-w-[24ch]">Mage portals and teleports in WoW Forever</h1>
    <div class="mt-4 max-w-[66ch] text-ink-soft leading-relaxed space-y-2">
      <p><strong>Short version.</strong> Teleports at 20 and 30, portals at 40 and 50, same as Classic.{" "}
        {newOnes.length > 0 && <>The one new spell is <strong>{newOnes.map((s) => s.name).join(", ")}</strong>, at level {newOnes[0].level}.</>}</p>
      <p>Teleports take you. Portals take your group. Each cast eats one rune.</p>
    </div>
  </header>

  <section class="py-8 grid gap-10 lg:grid-cols-2">
    {[["Teleports", teleports], ["Portals", portals]].map(([label, list]) => (
      <div>
        <h2 class="text-[1.35rem] mb-1">{label}</h2>
        {rune(list) && (
          <p class="text-[0.85rem] text-ink-faint mb-3">
            Costs {rune(list).count} {rune(list).item} per cast ({money(rune(list).price)} each at the vendor).
          </p>
        )}
        <table class="data">
          <thead><tr><th class="w-14">Level</th><th>Spell</th><th>Faction</th></tr></thead>
          <tbody>
            {list.map((s) => (
              <tr>
                <td class="font-mono text-ink-faint align-top">{s.level}</td>
                <td class="align-top">
                  {s.name}
                  {s.classic_status === "new" && <span class="ml-1.5 text-[0.62rem] uppercase tracking-wider border border-rust text-rust px-1">new</span>}
                  {s.description && <span class="block text-[0.8rem] text-ink-soft mt-0.5">{s.description}</span>}
                </td>
                <td class="align-top text-[0.85rem] text-ink-faint">{side(s.name)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}
  </section>

  <section class="py-8 border-t border-rule max-w-[70ch]">
    <h2 class="text-[1.25rem] mb-2">What the client doesn't tell you</h2>
    <p class="text-[0.92rem] text-ink-soft leading-relaxed">
      Training prices and which trainer teaches each city live on Blizzard's servers.
    </p>
    <p class="text-[0.92rem] text-ink-soft leading-relaxed mt-3">
      <strong>Can Horde mages learn Teleport: Dalaran?</strong> Not settled. The files give it to Alliance
      races, the same list as Teleport: Stormwind. Two more spells named Teleport: Dalaran sit in the files with
      no race attached, so a Horde version may exist. Nobody has confirmed it on a Horde mage yet.
    </p>
    <p class="text-[0.92rem] text-ink-soft leading-relaxed mt-3">
      There's no <span class="font-mono">Portal: Dalaran</span> for groups in the beta files, only the teleport.
    </p>
    <p class="text-[0.88rem] text-ink-soft mt-4">
      <a href="/classes/mage/spells/" class="underline decoration-rule-hard underline-offset-2 hover:decoration-rust">Every mage spell by level →</a>
      {" "}·{" "}
      <a href="/classes/mage/talent-changes/" class="underline decoration-rule-hard underline-offset-2 hover:decoration-rust">Mage changes vs Classic →</a>
    </p>
  </section>
</Base>
