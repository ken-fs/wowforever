---
import Base from "../../layouts/Base.astro";
import { all, one, slug, val } from "../../data/db.ts";

const build = val(`SELECT value FROM meta WHERE key='build'`);

const combos = all(`
  SELECT rc.race, rc.class, rc.race_id, rc.class_id, rc.is_skyborne
  FROM race_class rc ORDER BY rc.race, rc.class
`);

// 每个种族/职业的聚合，用来做矩阵行头列头
const races = [...new Set(combos.map((c) => c.race))].sort();
const classes = [...new Set(combos.map((c) => c.class))].sort();
const key = (r, c) => `${slug(r)}-${slug(c)}`;
const has = new Set(combos.map((c) => key(c.race, c.class)));

const byRace = Object.fromEntries(
  races.map((r) => [r, combos.filter((c) => c.race === r).map((c) => c.class)]),
);
---
<Base
  title="WoW Forever race and class combinations — all 56 listed"
  description="Every legal race and class combination in World of Warcraft: Forever, pulled from the game client. Includes both Skyborne races, which Blizzard's announcement never mentioned separately."
  crumbs={[{ href: "/", label: "Home" }, { label: "Race × Class" }]}
  {build}
>
  <header class="pt-8 pb-6 border-b border-rule">
    <h1 class="text-[2rem] leading-tight">{combos.length} race and class combinations</h1>
    <p class="mt-3 max-w-[64ch] text-ink-soft leading-relaxed">
      Read straight out of the client's <span class="font-mono text-[0.9em]">CharBaseInfo</span> table, which
      is the same list the character creator uses. If it isn't here, you can't roll it.
    </p>
  </header>

  <section class="py-8">
    <h2 class="text-[1.35rem] mb-1">The matrix</h2>
    <p class="text-[0.85rem] text-ink-faint mb-4">A tick means the combination exists. Click one for details.</p>
    <div class="overflow-x-auto -mx-5 px-5">
      <table class="data min-w-[640px]">
        <thead>
          <tr>
            <th class="sticky left-0 bg-paper pr-4">Race</th>
            {classes.map((c) => <th class="text-center w-[1%] whitespace-nowrap">{c}</th>)}
            <th class="text-right">Total</th>
          </tr>
        </thead>
        <tbody>
          {
            races.map((r) => (
              <tr>
                <th scope="row" class="sticky left-0 bg-paper font-normal pr-4 whitespace-nowrap">
                  <a href={`/races/${slug(r)}/`} class="hover:text-rust">{r}</a>
                </th>
                {classes.map((c) => (
                  <td class="text-center w-[1%]">
                    {has.has(key(r, c))
                      ? <a href={`/race-class/${key(r, c)}/`} class="text-moss font-mono hover:text-rust" aria-label={`${r} ${c}`}>●</a>
                      : <span class="text-rule-hard">·</span>}
                  </td>
                ))}
                <td class="text-right font-mono text-ink-faint">{byRace[r].length}</td>
              </tr>
            ))
          }
          <tr class="border-t-2 border-rule-hard">
            <th class="sticky left-0 bg-paper pt-2 text-left font-normal text-ink-faint">Total</th>
            {classes.map((c) => (
              <td class="text-center pt-2 font-mono text-ink-faint">
                {combos.filter((x) => x.class === c).length}
              </td>
            ))}
            <td class="text-right pt-2 font-mono text-rust font-semibold">{combos.length}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="py-8 grid gap-10 lg:grid-cols-[1fr_1fr] border-t border-rule">
    <div>
      <h2 class="text-[1.35rem] mb-3">By race</h2>
      <dl class="space-y-3">
        {
          races.map((r) => (
            <div class="grid grid-cols-[9.5rem_1fr] gap-3 items-baseline border-b border-rule pb-2">
              <dt>
                <a href={`/races/${slug(r)}/`} class="hover:text-rust">{r}</a>
                {r.includes("Skyborne") && <span class="tag ml-1.5 align-middle">new</span>}
              </dt>
              <dd class="text-[0.86rem] text-ink-soft">
                {byRace[r].map((c, i) => (
                  <>
                    {i > 0 && <span class="text-rule-hard">, </span>}
                    <a href={`/race-class/${key(r, c)}/`} class="hover:text-rust">{c}</a>
                  </>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div>
      <h2 class="text-[1.35rem] mb-3">By class</h2>
      <dl class="space-y-3">
        {
          classes.map((c) => {
            const list = combos.filter((x) => x.class === c).map((x) => x.race);
            return (
              <div class="grid grid-cols-[9.5rem_1fr] gap-3 items-baseline border-b border-rule pb-2">
                <dt><a href={`/classes/${slug(c)}/`} class="hover:text-rust">{c}</a></dt>
                <dd class="text-[0.86rem] text-ink-soft">
                  {list.map((r, i) => (
                    <>
                      {i > 0 && <span class="text-rule-hard">, </span>}
                      <a href={`/race-class/${key(r, c)}/`} class="hover:text-rust">{r}</a>
                    </>
                  ))}
                  <span class="text-ink-faint font-mono text-[0.78rem] ml-2">({list.length})</span>
                </dd>
              </div>
            );
          })
        }
      </dl>
      <p class="mt-4 text-[0.82rem] text-ink-faint">
        Paladin and Druid are the tight ones. Everything else is wide open.
      </p>
    </div>
  </section>
</Base>
