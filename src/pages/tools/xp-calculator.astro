---
import Base from "../../layouts/Base.astro";
import { all, val } from "../../data/db.ts";
import { Image } from "astro:assets";
import { buffFor } from "../../data/assets.ts";

const build = val(`SELECT value FROM meta WHERE key='build'`);

const curve = all(`SELECT level, xp FROM xp_curve ORDER BY level`);
const sources = all(`SELECT * FROM xp_source ORDER BY CASE kind WHEN 'all' THEN 0 WHEN 'quests' THEN 1 WHEN 'kills' THEN 2 WHEN 'creature' THEN 3 ELSE 4 END, pct DESC, name`);
// 计算器只放「全部经验 +X%」且数值读得出来的；只加击杀/任务/某类怪的放在下面的表里
const buffs = sources.filter((b) => b.kind === "all" && b.readable);
const boosts = sources.filter((b) => b.kind !== "rested");
const rested = sources.filter((b) => b.kind === "rested");
const questXp = all(`SELECT level, normal FROM quest_xp ORDER BY level`);
const total = curve.filter((c) => c.level < 60).reduce((a, c) => a + c.xp, 0);
const tent = rested.find((r) => /of a level/.test(r.text));
const tentPct = tent ? /(\d+)% of a level/.exec(tent.text)?.[1] : null;
const wellRested = rested.find((r) => r.name === "Well Rested");

const APPLIES = { all: "All XP", quests: "Quest XP", kills: "Kill XP", creature: "Some kills" };
// 只写数据能撑住的话。来源不在客户端的，就说不在。
const NOTE = {
  "Discoverer's Delight": "First seen as a catch-up buff in Season of Discovery. It's in the files; whether Forever turns it on is Blizzard's call.",
  "WoW Variety Show - The Winds of Inspiration!": "An event buff. Only up when Blizzard runs the event.",
  "Winds of Wisdom": "Marked CN only in the client. Not on US or EU realms.",
  "Well Fed XP Boost": "Kills only, and only when a condition the client doesn't name is met.",
  "Archmagister's Wisdom": "Undead kills only, for 5 minutes. The client doesn't say where you get it.",
  "Archmagister's Perception": "Same effect as Archmagister's Wisdom, from a different source.",
  "Adventure Awaits": "Its own tooltip says Season of Mastery. A leftover from that season, so don't count on it.",
  "Well-Rested": "The number points at a spell that isn't in the client, so we can't read it.",
};

const faq = [
  {
    q: "Is leveling faster in WoW Forever than in Classic?",
    a: `Not on paper. 1 to 60 costs ${total.toLocaleString()} XP, the same as Classic, and quests pay the same base XP at every level. What changed is where XP comes from: dungeon quests pay much more, and camps top up your rested XP.`,
  },
  {
    q: "What XP buffs are in WoW Forever?",
    a: `The beta client has ${boosts.length} XP buffs. The +50% ones are an event buff, a China-only buff and Discoverer's Delight. Well Fed adds 5% to kills, and two Archmagister buffs add 10% to Undead kills.`,
  },
  {
    q: "How does rested XP work with the Camp Tent?",
    a: tentPct
      ? `The Camp Tent tops your rested XP up to ${tentPct}% of a level, once an hour. It needs a campfire nearby and does nothing if you already have more rested XP than that.`
      : "The Camp Tent adds rested XP once an hour while you sit near it.",
  },
  {
    q: "Is there a dungeon XP buff in WoW Forever?",
    a: "No dungeon XP buff is in the beta client. Dungeon XP moved into dungeon quests instead: trash pays little, the quests inside pay a lot.",
  },
  {
    q: "Is there an XP potion in WoW Forever?",
    a: "No item in the beta client gives an XP buff. The only item that touches XP is the Camp Tent, and that's rested XP.",
  },
  {
    q: "Do XP buffs stack?",
    a: "They add up, they don't multiply. Two +50% buffs give you +100%, not +125%.",
  },
];

const title = "WoW Forever XP buffs, rested XP and leveling speed (calculator)";
const desc = `Every XP buff in the WoW Forever beta client, how Camp Tent rested XP works, and why 1–60 still costs ${total.toLocaleString()} XP. With a leveling calculator.`;
---
<Base title={title} description={desc.slice(0, 165)} crumbs={[
  { href: "/", label: "Home" },
  { href: "/tools/", label: "Tools" },
  { label: "XP buffs and calculator" },
]} {build}>
  <header class="pt-8 pb-6 border-b border-rule">
    <p class="tag mb-3">Leveling</p>
    <h1 class="text-[2rem] sm:text-[2.4rem] leading-tight max-w-[24ch]">WoW Forever XP buffs and leveling speed</h1>
    <div class="mt-4 max-w-[66ch] text-ink-soft leading-relaxed space-y-2">
      <p><strong>Short version.</strong> 1 to 60 costs <strong class="font-mono">{total.toLocaleString()}</strong> XP.
        That's Classic's curve, level for level. Quests pay Classic's base XP too.</p>
      <p>So Forever isn't faster because of the numbers. It's faster because dungeon quests pay a lot more,
        and camps keep topping up your rested XP. The +50% buffs below are events and leftovers, not something
        you'll have every day.</p>
    </div>
  </header>

  <section class="py-8">
    <h2 class="text-[1.35rem] mb-3">XP calculator</h2>
    <div class="border border-rule-hard bg-card">
      <div class="p-5 border-b border-rule">
        <div class="flex flex-wrap gap-x-8 gap-y-4 items-end">
          <div>
            <label for="from" class="block text-[0.75rem] uppercase tracking-wider text-ink-faint mb-1">From level</label>
            <input id="from" type="number" min="1" max="59" value="1"
              class="w-20 border border-rule-hard bg-paper px-2 py-1 font-mono text-[1.05rem]" />
          </div>
          <div>
            <label for="to" class="block text-[0.75rem] uppercase tracking-wider text-ink-faint mb-1">To level</label>
            <input id="to" type="number" min="2" max="60" value="60"
              class="w-20 border border-rule-hard bg-paper px-2 py-1 font-mono text-[1.05rem]" />
          </div>
          <div>
            <label for="xph" class="block text-[0.75rem] uppercase tracking-wider text-ink-faint mb-1">
              Your XP / hour <span class="normal-case tracking-normal">(guess it)</span>
            </label>
            <input id="xph" type="number" min="100" step="500" value="20000"
              class="w-28 border border-rule-hard bg-paper px-2 py-1 font-mono text-[1.05rem]" />
          </div>
        </div>
      </div>

      <div class="p-5 border-b border-rule">
        <p class="text-[0.75rem] uppercase tracking-wider text-ink-faint mb-3">Buffs you'll have up (all-XP buffs only)</p>
        <div class="grid gap-2 sm:grid-cols-2">
          {
            buffs.map((b) => (
              <label class="flex items-start gap-2.5 cursor-pointer group">
                <input type="checkbox" data-pct={b.pct} class="mt-1 accent-[#a63d1c]" />
                {buffFor(b.name) && (
                  <Image src={buffFor(b.name)!} alt="" width={32} height={32} format="webp"
                    class="shrink-0 border border-rule" aria-hidden="true" />
                )}
                <span>
                  <span class="font-medium group-hover:text-rust">{b.name}</span>
                  <span class="font-mono text-ochre ml-2">+{b.pct}%</span>
                  {b.cn_only ? <span class="tag ml-1.5">CN only</span> : null}
                  <span class="block text-[0.78rem] text-ink-faint mt-0.5">{b.text}</span>
                </span>
              </label>
            ))
          }
        </div>
      </div>

      <div class="p-5 grid gap-5 sm:grid-cols-3">
        <div>
          <p class="text-[0.75rem] uppercase tracking-wider text-ink-faint">Base XP needed</p>
          <p id="out-base" class="font-mono text-[1.6rem] text-ink">—</p>
        </div>
        <div>
          <p class="text-[0.75rem] uppercase tracking-wider text-ink-faint">
            XP multiplier <span id="out-mult-pct" class="text-ochre normal-case"></span>
          </p>
          <p id="out-mult" class="font-mono text-[1.6rem] text-ochre">—</p>
        </div>
        <div>
          <p class="text-[0.75rem] uppercase tracking-wider text-ink-faint">Hours at your rate</p>
          <p id="out-hours" class="font-mono text-[1.6rem] text-rust">—</p>
        </div>
      </div>
      <div class="px-5 pb-5 text-[0.85rem] text-ink-soft" id="out-extra"></div>
    </div>
  </section>

  <section class="py-8 border-t border-rule">
    <h2 class="text-[1.35rem] mb-1">Every XP buff in the client</h2>
    <p class="text-[0.9rem] text-ink-soft mb-4 max-w-[68ch]">
      Every spell in the beta client that changes how much XP you get. The numbers are the spell's own
      effect values, read from build <span class="font-mono">{build}</span>.
    </p>
    <table class="data">
      <thead><tr><th>Buff</th><th class="text-right">Bonus</th><th>Applies to</th><th class="hidden sm:table-cell">What we know</th></tr></thead>
      <tbody>
        {boosts.map((b) => (
          <tr>
            <td class="align-top">
              <span class="font-medium">{b.name}</span>
              <span class="block sm:hidden text-[0.8rem] text-ink-faint mt-0.5">{NOTE[b.name] ?? b.text}</span>
            </td>
            <td class="align-top text-right font-mono text-ochre">{b.readable ? `+${b.pct}%` : "?"}</td>
            <td class="align-top text-[0.88rem]">{b.kind === "creature" ? (/Undead/.test(b.text) ? "Undead kills" : APPLIES.creature) : APPLIES[b.kind]}</td>
            <td class="align-top hidden sm:table-cell text-[0.85rem] text-ink-soft">{NOTE[b.name] ?? b.text}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="mt-4 text-[0.88rem] text-ink-soft max-w-[68ch]">
      <strong>They add up, they don't multiply.</strong> Two +50% buffs give you +100%, not +125%.
    </p>
  </section>

  <section class="py-8 border-t border-rule grid gap-10 lg:grid-cols-[1.25fr_1fr]">
    <div>
      <h2 class="text-[1.35rem] mb-3">Rested XP and the Camp Tent</h2>
      <p class="text-[0.92rem] text-ink-soft leading-relaxed">
        Rested XP works like Classic: you earn it while logged out or in an inn, and it boosts your kill XP
        until it runs out. Forever adds two things on top.
      </p>
      <ul class="mt-3 space-y-2 text-[0.92rem] text-ink-soft">
        {tentPct && (
          <li><strong>Camp Tent.</strong> Sit near it and your rested XP gets topped up to {tentPct}% of a level.
            Once an hour. It needs a campfire nearby, and it does nothing if you already have more than that.</li>
        )}
        {wellRested && <li><strong>Well Rested.</strong> {wellRested.text}</li>}
      </ul>
      <p class="mt-3 text-[0.88rem] text-ink-soft">
        Used every hour, the tent is a small but steady top-up. <a href="/guides/camping/" class="underline decoration-rule-hard underline-offset-2 hover:decoration-rust">How camps work →</a>
      </p>

      <h2 class="text-[1.35rem] mb-3 mt-8">Is there a dungeon XP buff?</h2>
      <p class="text-[0.92rem] text-ink-soft leading-relaxed">
        No. There's no dungeon XP buff in the beta client. What Forever did instead is move dungeon XP
        into dungeon quests. Trash pays little. The quests inside pay a lot, and beta players report up to
        two levels from one dungeon run. <a href="/guides/leveling/" class="underline decoration-rule-hard underline-offset-2 hover:decoration-rust">Leveling guide →</a>
      </p>

      <h2 class="text-[1.35rem] mb-3 mt-8">Is there an XP potion?</h2>
      <p class="text-[0.92rem] text-ink-soft leading-relaxed">
        Not in the beta. No item in the client gives an XP buff. The only item that touches XP at all is the
        Camp Tent, and that's rested XP, not a potion.
      </p>

      <h2 class="text-[1.35rem] mb-3 mt-8">When do you get a mount?</h2>
      <p class="text-[0.92rem] text-ink-soft leading-relaxed">
        Level 40, same as Classic. It's much cheaper now: 20 gold instead of 80.
        <a href="/mounts/" class="underline decoration-rule-hard underline-offset-2 hover:decoration-rust">Mount levels and prices →</a>
      </p>
    </div>

    <aside>
      <h2 class="text-[1.15rem] mb-3">XP per level, 1 to 60</h2>
      <table class="data">
        <thead><tr><th>Level</th><th class="text-right">XP to next</th><th class="text-right">Total so far</th></tr></thead>
        <tbody id="curve-body"></tbody>
      </table>
      <p class="mt-3 text-[0.8rem] text-ink-faint">
        From the client's <span class="font-mono">LevelExperience</span> table. Same as Classic at every level.
        Quest XP (<span class="font-mono">QuestXP</span>) matches Classic too.
      </p>
    </aside>
  </section>

  <section class="py-8 border-t border-rule">
    <h2 class="text-[1.35rem] mb-4">Questions people ask</h2>
    <div class="space-y-5 max-w-[70ch]">
      {faq.map((f) => (
        <div>
          <h3 class="font-serif text-[1.05rem]">{f.q}</h3>
          <p class="text-[0.92rem] text-ink-soft leading-relaxed mt-1">{f.a}</p>
        </div>
      ))}
    </div>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  })}></script>

  <script type="application/json" id="xp-data" is:inline set:html={JSON.stringify({ curve, questXp })}></script>
  <script is:inline>
    const DATA = JSON.parse(document.getElementById("xp-data").textContent);
    const CURVE = DATA.curve, QXP = DATA.questXp;
    const el = (id) => document.getElementById(id);
    const need = (from, to) => {
      let x = 0;
      for (const c of CURVE) if (c.level >= from && c.level < to) x += c.xp;
      return x;
    };
    const fmt = (n) => Math.round(n).toLocaleString();

    function render() {
      let from = Math.min(59, Math.max(1, +el("from").value || 1));
      let to = Math.min(60, Math.max(2, +el("to").value || 60));
      if (to <= from) to = Math.min(60, from + 1);
      const xph = Math.max(100, +el("xph").value || 20000);

      const base = need(from, to);
      let bonus = 0;
      document.querySelectorAll("input[type=checkbox][data-pct]").forEach((cb) => {
        if (cb.checked) bonus += parseFloat(cb.dataset.pct);
      });
      const mult = 1 + bonus / 100;
      const eff = base / mult;

      el("out-base").textContent = fmt(base);
      el("out-mult").textContent = mult.toFixed(2) + "\u00d7";
      el("out-mult-pct").textContent = bonus ? "+ " + bonus + "%" : "no buffs";
      el("out-hours").textContent = (eff / xph).toFixed(1) + " h";

      const saved = base - eff;
      const q = QXP.find((x) => x.level === from);
      let extra = "";
      if (saved > 0) extra += "Buffs save you " + fmt(saved) + " XP. ";
      if (q && q.normal > 0) {
        extra += "At level " + from + " a normal quest pays about " + fmt(q.normal)
               + " XP, so that is roughly " + fmt(eff / q.normal) + " quests if you only quested.";
      }
      el("out-extra").textContent = extra;
    }

    const SHOW = [1, 2, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 59];
    let run = 0, rows = "";
    for (const c of CURVE) {
      if (c.level >= 60) continue;   // 60 级那行是 60→61 的 XP，游戏里不存在
      run += c.xp;
      if (SHOW.includes(c.level)) {
        rows += '<tr><td class="font-mono">' + c.level + '</td><td class="text-right font-mono">'
              + fmt(c.xp) + '</td><td class="text-right font-mono text-ink-faint">' + fmt(run) + "</td></tr>";
      }
    }
    rows += '<tr><td class="font-mono text-rust">60</td><td class="text-right text-ink-faint">\u2014</td>'
          + '<td class="text-right font-mono text-rust">' + fmt(run) + "</td></tr>";
    document.getElementById("curve-body").innerHTML = rows;

    document.querySelectorAll("input").forEach((i) => {
      i.addEventListener("input", render);
      i.addEventListener("change", render);
    });
    render();
  </script>
</Base>
