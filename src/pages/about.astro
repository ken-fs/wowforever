---
import Base from "../layouts/Base.astro";
import { val, count } from "../data/db.ts";
const build = val(`SELECT value FROM meta WHERE key='build'`);
const builtAt = val(`SELECT value FROM meta WHERE key='built_at'`);
const tables = count("tables");
const rows: [string, number][] = [
  ["Spells", count("spells")],
  ["Rare+ items", count("items_rare")],
  ["Item sets", count("sets")],
  ["Talent points", val(`SELECT COUNT(*) FROM talent_full`)],
  ["Recipes", val(`SELECT COUNT(*) FROM recipe`)],
  ["Race/class combos", val(`SELECT COUNT(*) FROM race_class`)],
  ["New combos vs Classic", val(`SELECT COUNT(*) FROM race_class_new`)],
  ["Level curve rows", val(`SELECT COUNT(*) FROM xp_curve`)],
];
---
<Base title="About this site and where the data comes from" description="How wowforever.one is built: data pulled from the World of Warcraft client's own files, rebuilt on every beta build, with sources stated on every page." crumbs={[{ href: "/", label: "Home" }, { label: "About" }]} {build}>
  <header class="pt-8 pb-6 border-b border-rule">
    <h1 class="text-[2rem] leading-tight">Where the numbers come from</h1>
    <p class="mt-3 max-w-[66ch] text-ink-soft leading-relaxed">
      Every figure on this site is read out of the game client itself — the same files your copy of
      World of Warcraft: Forever loads. Nothing is copied from another fan site, and nothing is estimated
      unless the page says so.
    </p>
  </header>

  <section class="py-8 grid gap-10 lg:grid-cols-[1.2fr_1fr]">
    <div>
      <h2 class="text-[1.3rem] mb-3">The pipeline</h2>
      <ol class="space-y-3 text-[0.92rem] text-ink-soft leading-relaxed list-none">
        <li class="grid grid-cols-[1.4rem_1fr] gap-2">
          <span class="font-mono text-rust">1</span>
          <span>Ask Blizzard's patch server which build is current for the Forever client.</span>
        </li>
        <li class="grid grid-cols-[1.4rem_1fr] gap-2">
          <span class="font-mono text-rust">2</span>
          <span>Pull the client's data tables for that exact build and load them into a local database.</span>
        </li>
        <li class="grid grid-cols-[1.4rem_1fr] gap-2">
          <span class="font-mono text-rust">3</span>
          <span>Rebuild every page on this site from that database.</span>
        </li>
      </ol>
      <p class="mt-4 text-[0.92rem] text-ink-soft leading-relaxed">
        It runs end to end in about eighty seconds, so when Blizzard pushes a build the pages can be rebuilt
        the same day. Current build: <span class="font-mono text-ink">{build}</span>
        {builtAt ? <> (pulled <span class="font-mono">{String(builtAt).slice(0, 10)}</span>)</> : null}.
      </p>

      <h2 class="text-[1.3rem] mb-3 mt-8">What that means in practice</h2>
      <p class="text-[0.92rem] text-ink-soft leading-relaxed">
        Some things that are true in the client are still unknown out here. If a value is stored as a
        reference to something that isn't shipped to players, this site leaves it out and says so — the
        XP calculator's exclusion note is the clearest example. A wrong number is worse than a missing one.
      </p>
      <p class="text-[0.92rem] text-ink-soft leading-relaxed mt-3">
        Quest text, NPCs, and the Legacy tree relationships are the big gaps. Quest data lives on Blizzard's
        servers, not in the client, so nobody can mine it — sites that have quest pages got them by playing
        the beta and typing them up.
      </p>
    </div>

    <aside>
      <h2 class="text-[1.15rem] mb-3">Indexed right now</h2>
      <table class="data">
        <thead><tr><th>Thing</th><th class="text-right">Count</th></tr></thead>
        <tbody>
          {
            rows.map(([label, n]) => (
              <tr>
                <td>{label}</td>
                <td class="text-right font-mono">{Number(n).toLocaleString()}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="mt-3 text-[0.8rem] text-ink-faint">
        {Number(tables).toLocaleString()} tables loaded in total.
      </p>
    </aside>
  </section>

  <section class="py-8 border-t border-rule">
    <h2 class="text-[1.3rem] mb-3">Legal</h2>
    <p class="text-[0.9rem] text-ink-soft leading-relaxed max-w-[70ch]">
      This is an unofficial fan resource. World of Warcraft, Warcraft and all associated assets are
      trademarks of Blizzard Entertainment, Inc. This site is not affiliated with, endorsed by, or
      sponsored by Blizzard. Game data is reproduced for reference and commentary.
      Found something wrong? Corrections are welcome.
    </p>
  </section>
</Base>
