---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { val } from "../../data/db.ts";
const build = val(`SELECT value FROM meta WHERE key='build'`);
const guides = (await getCollection("guides")).sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf(),
);
---
<Base title="WoW Forever guides" description="Plain-language guides to World of Warcraft: Forever's systems — the Legacy tree, camping, leveling, professions and the class rewrites. Sourced, not vibes." crumbs={[{ href: "/", label: "Home" }, { label: "Guides" }]} {build}>
  <header class="pt-8 pb-6 border-b border-rule">
    <h1 class="text-[2rem] leading-tight">Guides</h1>
    <p class="mt-3 max-w-[64ch] text-ink-soft leading-relaxed">
      Written from Blizzard's own documentation, the game client, and creators who are actually in the beta.
      Every page lists its sources at the bottom. Where two sources disagree, both get quoted.
    </p>
  </header>

  <section class="py-8">
    <div class="space-y-5">
      {
        guides.map((g) => (
          <a href={`/guides/${g.id}/`} class="block border-t-2 border-rule-hard pt-4 hover:border-rust transition-colors">
            <h2 class="font-serif text-[1.3rem]">{g.data.title}</h2>
            <p class="mt-1.5 text-[0.9rem] text-ink-soft leading-relaxed max-w-[70ch]">{g.data.description}</p>
            <p class="mt-2 font-mono text-[0.75rem] text-ink-faint">
              {g.data.facts.map((f, i) => (
                <>{i > 0 && <span class="text-rule-hard"> · </span>}<span class="text-rust">{f.v}</span>{" "}{f.k}</>
              ))}
            </p>
          </a>
        ))
      }
    </div>
    {guides.length === 0 && <p class="text-ink-faint">First guides are being written now.</p>}
  </section>
</Base>
