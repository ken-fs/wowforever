---
import AdBreak from "../components/AdBreak.astro";
import Base from "../layouts/Base.astro";
import { all, val, one, count, slug } from "../data/db.ts";
import { Image } from "astro:assets";
import { hero, ogImage, classIcon, specFor, attribution } from "../data/assets.ts";
import LaunchTimeline from "../components/LaunchTimeline.astro";

const build = val(`SELECT value FROM meta WHERE key='build'`);

// 首页要的是"能立刻用的东西"，不是营销文案
const combos = all(`SELECT race, class, is_skyborne FROM race_class ORDER BY race, class`);
const skyborne = combos.filter((c) => c.is_skyborne);
const undead = combos.filter((c) => c.race === "Undead").map((c) => c.class);

const counts = {
  combos: combos.length,
  classes: val(`SELECT COUNT(*) FROM (SELECT DISTINCT class FROM race_class)`),
  races: val(`SELECT COUNT(DISTINCT race) FROM race_class`),
  talents: val(`SELECT COUNT(*) FROM talent_full`),
  recipes: val(`SELECT COUNT(*) FROM recipe`),
  items: count("items_rare"),
  xpbuffs: val(`SELECT COUNT(DISTINCT name) FROM xp_spell WHERE reliable = 1 AND aura = 200`),
  dungeons: count("dungeons"),
};

// 首页职业网格：每个职业 + 它的 3 个天赋树图标
const specGroups = all(`SELECT DISTINCT class, tab FROM talent_full WHERE class <> '' ORDER BY class, tab`)
  .reduce((acc, r) => {
    let g = acc.find((x) => x.cls === r.class);
    if (!g) { g = { cls: r.class, specs: [] }; acc.push(g); }
    g.specs.push({ name: r.tab, img: specFor(r.class, r.tab) });
    return acc;
  }, [] as { cls: string; specs: { name: string; img: any }[] }[]);

// 首页 Bento 的数字 —— 全部现查，不写死
const xpTotal = all(`SELECT xp FROM xp_curve WHERE level < 60`).reduce((x, r) => x + r.xp, 0);
const mountCheap = val(`SELECT MIN(price) FROM mount WHERE level = 40 AND price > 0 AND in_classic = 1`);
const mountClassic = val(`SELECT MIN(classic_price) FROM mount WHERE level = 40 AND price = ? AND classic_price > 0`, mountCheap);
const swift = val(`SELECT MIN(price) FROM mount WHERE level = 60 AND price > 0 AND in_classic = 1 AND classic_price = 10000000`);
const talentsChanged = val(`SELECT COUNT(*) FROM talent_node WHERE status IN ('new','changed')`);
const newCombos = val(`SELECT COUNT(*) FROM race_class_new`);
const spellsNew = val(`SELECT COUNT(DISTINCT class || name) FROM spellbook s WHERE NOT EXISTS (SELECT 1 FROM spellbook t WHERE t.class = s.class AND t.name = s.name AND t.classic_status <> 'new')`);
const g = (c) => Math.round(c / 10000);

const NEWSWORTHY = [
  {
    k: "The Skyborne are two races, not one",
    v: `The client ships <strong>High Order Skyborne</strong> and <strong>Windshaper Skyborne</strong> as separate playable races (IDs 95 and 96). Blizzard's announcement only ever described one.`,
  },
  {
    k: "Undead can be Paladins",
    v: `Undead picks up ${undead.length} classes — and Paladin is one of them. That single line has spawned a 14,000-view forum thread.`,
  },
  {
    k: "Paladins are down to three races",
    v: `Human, Dwarf, Undead. That's it. Druids get four, and two of them are the Skyborne.`,
  },
];
---
<Base
  title="WoW Forever by the numbers: talent calculator, XP, mounts and what changed"
  description="WoW Forever data read from the beta client: a talent calculator for all nine classes, XP buffs, mount prices, race and class combos, and what changed since Classic."
  {build}
>
  <!-- 首屏：Cullet 式大字 + 熔融光晕（纯 CSS，三团径向渐变慢速漂移） -->
  <section class="hero relative pt-16 sm:pt-24 pb-14">
    <div class="hero-glow" aria-hidden="true"><span></span><span></span><span></span></div>
    <p class="relative tag mb-6">Beta build {build} · launches 4 Nov</p>
    <h1 class="relative text-[2.7rem] sm:text-[4.4rem] lg:text-[5.4rem] leading-[0.95] max-w-[14ch]">
      WoW Forever, <span class="text-rust">by the numbers.</span>
    </h1>
    <div class="relative mt-8 grid gap-6 sm:grid-cols-[minmax(0,34rem)_auto] sm:items-end sm:justify-between">
      <p class="text-[1.05rem] text-ink-soft leading-relaxed">
        Talents, XP, mounts and race combos, read straight out of the beta client.
        Rebuilt every time Blizzard pushes a build. No guessing.
      </p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href="/tools/talent-calculator/" class="btn-ember">Open the talent calculator</a>
        <a href="/changes/" class="arrow-link text-[0.95rem] font-semibold">What changed <span class="arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- Bento：每块一个硬数字 -->
  <section class="grid gap-3 sm:gap-4 grid-cols-2 lg:grid-cols-12 auto-rows-[minmax(9.5rem,auto)] pb-10">
    <a href="/tools/talent-calculator/" class="card col-span-2 lg:col-span-6 lg:row-span-2 p-6 flex flex-col justify-between overflow-hidden">
      <div>
        <p class="text-[0.85rem] text-ink-faint font-semibold">Talent calculator</p>
        <p class="mt-2 font-serif text-[3.4rem] sm:text-[4.2rem] leading-none tracking-[-0.05em]">{Number(counts.talents)}</p>
        <p class="mt-2 text-[0.95rem] text-ink-soft max-w-[34ch]">talents in their real spots. {talentsChanged} are new or changed since Classic.</p>
      </div>
      <div class="mt-6 grid grid-cols-9 gap-1.5 max-w-[26rem]">
        {specGroups.map(({ cls }) => classIcon[slug(cls)] && (
          <Image src={classIcon[slug(cls)]!} alt={cls} width={40} height={40} format="webp" class="rounded-[6px] w-full h-auto" />
        ))}
      </div>
      <span class="arrow-link mt-5 text-[0.9rem] font-semibold text-rust">Plan a build <span class="arrow">→</span></span>
    </a>

    <a href="/tools/xp-calculator/" class="card col-span-2 sm:col-span-1 lg:col-span-3 p-5 flex flex-col justify-between">
      <p class="text-[0.85rem] text-ink-faint font-semibold">XP, 1 to 60</p>
      <div>
        <p class="font-serif text-[1.75rem] leading-none tracking-[-0.05em]">{xpTotal.toLocaleString()}</p>
        <p class="mt-2 text-[0.85rem] text-ink-soft">Same curve as Classic. Here's what speeds it up.</p>
      </div>
    </a>

    {mountCheap && (
      <a href="/mounts/" class="card col-span-2 sm:col-span-1 lg:col-span-3 p-5 flex flex-col justify-between">
        <p class="text-[0.85rem] text-ink-faint font-semibold">First mount</p>
        <div>
          <p class="font-serif text-[2.4rem] leading-none tracking-[-0.05em] text-rust">{g(mountCheap)}g</p>
          <p class="mt-2 text-[0.85rem] text-ink-soft">Was {mountClassic ? g(mountClassic) : 80}g in Classic. Swift is {swift ? g(swift) : 200}g.</p>
        </div>
      </a>
    )}

    <a href="/race-class/" class="card col-span-1 lg:col-span-3 p-5 flex flex-col justify-between">
      <p class="text-[0.85rem] text-ink-faint font-semibold">Race × class</p>
      <div>
        <p class="font-serif text-[2.4rem] leading-none tracking-[-0.05em]">{counts.combos}</p>
        <p class="mt-2 text-[0.85rem] text-ink-soft">{newCombos} are new. Undead Paladin is one.</p>
      </div>
    </a>

    <a href="/changes/" class="card col-span-1 lg:col-span-3 p-5 flex flex-col justify-between">
      <p class="text-[0.85rem] text-ink-faint font-semibold">New spells</p>
      <div>
        <p class="font-serif text-[2.4rem] leading-none tracking-[-0.05em]">{spellsNew}</p>
        <p class="mt-2 text-[0.85rem] text-ink-soft">across nine classes. Penance, Ice Lance, Victory Rush…</p>
      </div>
    </a>

    {hero && (
      <figure class="tile col-span-2 lg:col-span-7 lg:row-span-2 overflow-hidden relative min-h-[16rem]">
        <Image src={hero} alt="Official key art for World of Warcraft: Forever" widths={[480, 820]}
          sizes="(max-width: 1023px) 100vw, 680px" format="webp" loading="eager" fetchpriority="high" decoding="async"
          class="absolute inset-0 w-full h-full object-cover opacity-80" />
        <div class="absolute inset-0 bg-gradient-to-t from-paper via-paper/30 to-transparent"></div>
        <figcaption class="absolute left-5 right-5 bottom-5">
          <p class="font-serif text-[1.5rem] sm:text-[1.9rem] leading-tight tracking-[-0.04em]">Launch: 4 November</p>
          <p class="text-[0.85rem] text-ink-soft mt-1"><span data-home-countdown>3 p.m. PST</span> · <a href="#timeline" class="underline decoration-rule-hard underline-offset-2 hover:decoration-rust">Every date →</a></p>
          <p class="text-[0.7rem] text-ink-faint mt-2">Key art from Blizzard's Forever announcement.</p>
        </figcaption>
      </figure>
    )}

    <div class="tile col-span-2 lg:col-span-5 lg:row-span-2 p-6">
      <p class="text-[0.85rem] text-ink-faint font-semibold mb-4">What the announcement didn't say</p>
      <dl class="space-y-5">
        {NEWSWORTHY.map((n) => (
          <div>
            <dt class="font-bold text-[1rem]">{n.k}</dt>
            <dd class="text-[0.88rem] text-ink-soft mt-1 leading-relaxed" set:html={n.v} />
          </div>
        ))}
      </dl>
    </div>
  </section>

  <a href="/guides/first-40-hours/" class="card block p-6 sm:p-7 mb-10 sm:flex sm:items-center sm:justify-between sm:gap-10">
    <span class="block">
      <span class="tag mb-3">New to Forever?</span>
      <span class="block font-serif text-[1.5rem] sm:text-[1.8rem] leading-tight tracking-[-0.04em]">
        Your first 40 hours, in order
      </span>
      <span class="mt-2 block text-[0.92rem] text-ink-soft max-w-[60ch] leading-relaxed">
        What to pick before launch, when camping unlocks, and why you can't skip dungeons any more.
      </span>
    </span>
    <span class="btn-ember mt-4 sm:mt-0 shrink-0">Read it</span>
  </a>

  <section class="py-9 border-t border-rule">
    <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
      <h2 class="text-[1.8rem] sm:text-[2.2rem]">Pick a class</h2>
      <p class="text-[0.82rem] text-ink-faint">Icons from the game client.</p>
    </div>
    <p class="text-[0.95rem] text-ink-soft mb-6 max-w-[60ch]">
      Each one opens its talent calculator, spells by level and what changed since Classic.
    </p>
    <div class="grid gap-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-5">
      {
        specGroups.map(({ cls, specs }) => (
          <a href={`/classes/${slug(cls)}/`} class="card block p-3">
            <span class="flex items-center gap-2 mb-2">
              {classIcon[slug(cls)] && (
                <Image src={classIcon[slug(cls)]!} alt="" width={30} height={30}
                  format="webp" class="shrink-0" aria-hidden="true" />
              )}
              <span class="font-serif text-[0.98rem]">{cls}</span>
            </span>
            <span class="flex flex-wrap gap-1.5">
              {specs.map((sp) => (
                <span title={sp.name}>
                  {sp.img ? (
                    <Image src={sp.img} alt="" width={18} height={18} format="webp"
                      class="border border-rule" aria-hidden="true" />
                  ) : null}
                </span>
              ))}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <LaunchTimeline />

  <script is:inline>
    (function () {
      var el = document.querySelector("[data-home-countdown]");
      if (!el) return;
      var d = Date.parse("2026-11-04T23:00:00Z") - Date.now();
      if (d <= 0) { el.textContent = "Live now"; return; }
      var days = Math.floor(d / 864e5), hrs = Math.floor((d % 864e5) / 36e5);
      el.textContent = days + " days, " + hrs + " hours to go";
    })();
  </script>

<AdBreak />

  <section class="py-9 border-t border-rule">
    <div class="flex flex-wrap items-baseline justify-between gap-2 mb-4">
      <h2 class="text-[1.6rem]">Browse</h2>
      <p class="text-[0.82rem] text-ink-faint">Rebuilt from the client every patch.</p>
    </div>
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        [
          { href: "/classes/", t: "Classes", d: `${counts.classes} classes, three trees each` },
          { href: "/races/", t: "Races", d: `${counts.races} playable races` },
          { href: "/race-class/", t: "Combos", d: `${counts.combos} combinations` },
          { href: "/changes/", t: "What changed", d: `${newCombos} new combos, ${talentsChanged} talents reworked` },
        ].map((c) => (
          <a href={c.href} class="border-t-2 border-rule-hard pt-3 hover:border-rust transition-colors">
            <span class="font-serif text-[1.05rem]">{c.t}</span>
            <span class="block text-[0.82rem] text-ink-faint mt-0.5">{c.d}</span>
          </a>
        ))
      }
    </div>

    <div class="mt-8 text-[0.88rem] text-ink-soft max-w-[70ch]">
      <p><strong>{Number(counts.talents).toLocaleString()}</strong> talents (see <a href="/changes/" class="underline decoration-rule-hard underline-offset-2 hover:decoration-rust">what changed since Classic</a>) and <strong>{Number(counts.recipes).toLocaleString()}</strong> profession recipes are indexed. <a href="/about/" class="underline decoration-rule-hard underline-offset-2 hover:decoration-rust">How this is built &rarr;</a></p>
    </div>
  </section>
</Base>
