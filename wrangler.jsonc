{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wowforever",
  "compatibility_date": "2026-09-01",
  // 纯静态站：dist/ 直接作为 assets 部署，没有 Worker 脚本
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
    // ⚠️ 别加 "html_handling": "none" 来消除 /ads/x.html 的 307 ——
    // 那个默认行为（auto-trailing-slash）同时也是**整站目录式 URL**
    // （/tools/xp-calculator/ → .../index.html）能工作的原因。
    // 为了省广告位一次同源重定向而关掉它，是拿全站 113 页赌一个可忽略的开销。
    // 307 本身无害：iframe 会自动跟随，且广告位是 lazy 加载的。
  }
}
